{
  "name": "@pixel3d/ui",
  "version": "0.1.0",
  "description": "Die-cut sticker pixel-art + 3D React components for hackathons.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
